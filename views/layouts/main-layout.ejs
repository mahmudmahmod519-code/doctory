<%#
  Minimal centered shell for the auth screens (login, 2FA, forgot / reset password, email verification).

    include('../layouts/main-layout', { part: 'top' })
      ... card ...
    include('../layouts/main-layout', { part: 'bottom' })

  Locals: part, pageTitle
%>
<% if (part === 'top') { %>
<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-surface text-on-surface antialiased">
  <main id="main" class="relative w-full min-h-screen flex flex-col items-center justify-center px-4 py-10 overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-20 w-96 h-96 rounded-full bg-primary/5 blur-3xl"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 -left-20 w-96 h-96 rounded-full bg-secondary-container/25 blur-3xl"></div>
    <a href="/" class="relative z-10 mb-6 flex items-center gap-2.5" data-animate="fade">
      <span class="w-10 h-10 rounded-xl bg-primary-container flex items-center justify-center text-on-primary shadow-sm"><span class="material-symbols-outlined icon-fill">local_hospital</span></span>
      <span class="font-headline-sm text-headline-sm font-extrabold text-primary">دكتوري</span>
    </a>
    <div class="relative z-10 w-full flex flex-col items-center">
<% } else { %>
    </div>
    <p class="relative z-10 mt-6 font-label-sm text-label-sm text-on-surface-variant flex items-center gap-2">
      <span class="material-symbols-outlined text-[16px] text-secondary">encrypted</span>
      اتصال مشفّر · © <%= new Date().getFullYear() %> Doctory
    </p>
  </main>
  <%- include('../partials/modal-confirm') %>
  <%- include('../partials/flash-messages') %>
<% } %>
