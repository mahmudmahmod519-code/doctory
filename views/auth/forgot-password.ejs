<%# GET /auth/forgot-password — API: POST /api/auth/forgot-password { email } (generic response, anti-enumeration) %>
<%- include('../layouts/main-layout', { part: 'top', pageTitle: 'نسيت كلمة المرور' }) %>
<section class="w-full max-w-md" data-animate="scale"><div class="bg-surface-container-lowest shadow-xl rounded-2xl p-6 sm:p-9 text-center">
  <div class="w-16 h-16 rounded-full bg-primary-fixed text-primary mx-auto flex items-center justify-center mb-4"><span class="material-symbols-outlined icon-fill text-[32px]">lock_reset</span></div>
  <h1 class="font-headline-md text-headline-md font-extrabold">نسيت كلمة المرور؟</h1>
  <p class="font-body-md text-body-md text-on-surface-variant mt-1 mb-6">أدخل بريدك وسنرسل لك رابط إعادة التعيين (صالح لمدة ساعة).</p>
  <form id="f" class="flex flex-col gap-4 text-right" novalidate>
    <div class="flex flex-col gap-1.5"><label for="email" class="font-label-md text-label-md font-semibold">البريد الإلكتروني</label><input id="email" name="email" type="email" dir="ltr" autocomplete="email" class="field" placeholder="name@example.com" /><p data-error-for="email" class="hidden font-label-sm text-label-sm text-error"></p></div>
    <button id="go" type="submit" class="h-12 rounded-lg bg-primary-container text-on-primary font-title-md text-title-md shadow-md">إرسال الرابط</button>
  </form>
  <div id="sent" class="hidden flex-col items-center gap-2 text-center"><span class="material-symbols-outlined icon-fill text-secondary text-[40px]">mark_email_read</span><p class="font-body-md text-body-md">إن كان هذا البريد مسجّلاً لدينا فستصلك رسالة خلال دقائق. تحقق أيضاً من البريد المزعج.</p></div>
  <a href="/auth/login" class="inline-flex items-center gap-1 mt-5 font-label-md text-label-md text-on-surface-variant hover:text-primary"><span class="material-symbols-outlined text-[18px]">arrow_forward</span>العودة لتسجيل الدخول</a>
</div></section>
<%- include('../layouts/main-layout', { part: 'bottom' }) %>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const f = document.getElementById('f'), btn = document.getElementById('go');
  f.addEventListener('submit', async (e) => {
    e.preventDefault(); const email = f.email.value.trim().toLowerCase();
    if (!/^\S+@\S+\.\S+$/.test(email)) return Doctory.showFieldErrors(f, { email: 'أدخل بريداً إلكترونياً صحيحاً' });
    Doctory.showFieldErrors(f, {}); Doctory.setBusy(btn, true, 'جارٍ الإرسال...');
    try { await Doctory.api('POST', '/api/auth/forgot-password', { email }, { redirectOn401: false }); } catch (err) { if (err.status === 400) { Doctory.setBusy(btn, false); return Doctory.showFieldErrors(f, { email: err.message }); } }
    f.classList.add('hidden'); const s = document.getElementById('sent'); s.classList.remove('hidden'); s.classList.add('flex');
  });
});
</script>
</body>
</html>
