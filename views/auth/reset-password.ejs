<%# GET /auth/reset-password/:token — API: POST /api/auth/reset-password { token, new_password } → /auth/login %>
<%- include('../layouts/main-layout', { part: 'top', pageTitle: 'إعادة تعيين كلمة المرور' }) %>
<section class="w-full max-w-md" data-animate="scale"><div class="bg-surface-container-lowest shadow-xl rounded-2xl p-6 sm:p-9">
  <div class="text-center mb-6"><h1 class="font-headline-md text-headline-md font-extrabold">كلمة مرور جديدة</h1><p class="font-body-md text-body-md text-on-surface-variant mt-1">اختر كلمة مرور قوية لا تستخدمها في مكان آخر.</p></div>
  <form id="f" class="flex flex-col gap-4" novalidate>
    <div id="form-alert" role="alert" class="hidden p-3 rounded-lg bg-error-container text-on-error-container font-body-md text-body-md"></div>
    <div class="flex flex-col gap-1.5 relative"><label for="password" class="font-label-md text-label-md font-semibold">كلمة المرور الجديدة</label><input id="password" name="password" type="password" autocomplete="new-password" class="field pl-11" /><button type="button" data-toggle-password="password" aria-label="إظهار كلمة المرور" class="absolute left-2.5 top-[34px] w-8 h-8 text-on-surface-variant flex items-center justify-center"><span class="material-symbols-outlined text-[20px]">visibility</span></button><p data-error-for="password" class="hidden font-label-sm text-label-sm text-error"></p></div>
    <div class="flex flex-col gap-1.5"><label for="confirm" class="font-label-md text-label-md font-semibold">تأكيد كلمة المرور</label><input id="confirm" name="confirm" type="password" autocomplete="new-password" class="field" /><p data-error-for="confirm" class="hidden font-label-sm text-label-sm text-error"></p></div>
    <button id="go" type="submit" class="h-12 rounded-lg bg-primary-container text-on-primary font-title-md text-title-md shadow-md">حفظ كلمة المرور</button>
  </form>
</div></section>
<%- include('../layouts/main-layout', { part: 'bottom' }) %>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const token = '<%= typeof token !== "undefined" ? token : "" %>' || location.pathname.split('/').pop();
  const f = document.getElementById('f'), btn = document.getElementById('go'), box = document.getElementById('form-alert');
  f.addEventListener('submit', async (e) => {
    e.preventDefault(); box.classList.add('hidden'); const er = {};
    if (f.password.value.length < 6) er.password = '6 أحرف على الأقل';
    if (f.password.value !== f.confirm.value) er.confirm = 'كلمتا المرور غير متطابقتين';
    Doctory.showFieldErrors(f, er); if (Object.keys(er).length) return;
    Doctory.setBusy(btn, true, 'جارٍ الحفظ...');
    try { await Doctory.api('POST', '/api/auth/reset-password', { token, new_password: f.password.value }, { redirectOn401: false });
      location.href = '/auth/login?flash=' + encodeURIComponent('تم تغيير كلمة المرور، سجّل دخولك الآن'); }
    catch (err) { Doctory.setBusy(btn, false); box.innerHTML = err.status === 400 ? 'الرابط غير صالح أو منتهي. <a href="/auth/forgot-password" class="font-bold underline">اطلب رابطاً جديداً</a>' : Doctory.esc(err.message); box.classList.remove('hidden'); }
  });
});
</script>
</body>
</html>
