<%# GET /patient/appointment-cancelled?reason=doctor_rejected|system|decline_limit&booking= %>
<%- include('../layouts/patient-layout', { part: 'top', active: 'dashboard', pageTitle: 'تم إلغاء الموعد' }) %>
<% const reasons = { doctor_rejected: 'اعتذر الطبيب عن هذا الموعد.', system: 'تم إلغاء الموعد من قِبل النظام.', decline_limit: 'تم الإلغاء بعد استنفاد محاولات تأجيل الدور.' };
   const msg = reasons[reason] || 'تم إلغاء هذا الموعد.'; %>
