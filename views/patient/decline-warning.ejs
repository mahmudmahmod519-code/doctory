<%# GET /patient/decline-warning?booking= — first decline notice: confirm (PATCH /api/patient/queue/:id/confirm) or reschedule (→ /doctors) %>
<%- include('../layouts/patient-layout', { part: 'top', active: 'queue', pageTitle: 'تنبيه' }) %>
<section class="max-w-xl mx-auto w-full bg-surface-container-lowest rounded-2xl shadow-lift p-8 text-center flex flex-col items-center gap-5" data-animate="scale">
  <div class="w-20 h-20 rounded-full bg-tertiary-fixed text-tertiary flex items-center justify-center"><span class="material-symbols-outlined icon-fill text-[40px]">warning</span></div>
  <h1 class="font-headline-md text-headline-md font-extrabold">تم تأجيل دورك مرة</h1>
  <p class="font-body-md text-body-md text-on-surface-variant max-w-md">بقيت لك محاولة واحدة فقط. عند تكرار التأجيل سيتم إلغاء الحجز تلقائياً وسيُفتح الدور للمريض التالي.</p>
  <div class="grid sm:grid-cols-2 gap-3 w-full">
    <button id="confirm" class="h-12 rounded-lg bg-primary-container text-on-primary font-title-md text-title-md">تأكيد الموعد</button>
    <a href="/doctors" class="h-12 rounded-lg bg-surface-container-low hover:bg-surface-container font-label-md text-label-md inline-flex items-center justify-center">إعادة الجدولة</a>
  </div>
</section>
<%- include('../layouts/patient-layout', { part: 'bottom' }) %>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const id = new URLSearchParams(location.search).get('booking') || '<%= typeof bookingItemId !== "undefined" && bookingItemId ? bookingItemId : "" %>';
  document.getElementById('confirm').addEventListener('click', async (e) => {
    Doctory.setBusy(e.currentTarget, true, 'جارٍ التأكيد...');
    try { await Doctory.api('PATCH', '/api/patient/queue/' + encodeURIComponent(id) + '/confirm'); location.href = '/patient/waiting-queue?booking=' + encodeURIComponent(id) + '&flash=' + encodeURIComponent('تم تأكيد موعدك'); }
    catch (err) { Doctory.setBusy(e.currentTarget, false); Doctory.toast(err.message, 'error'); }
  });
});
</script>
</body>
</html>
