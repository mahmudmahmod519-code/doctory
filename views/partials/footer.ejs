<%# Public footer. Locals: variant ('full' default | 'compact' for dashboards) %>
<% if (typeof variant !== 'undefined' && variant === 'compact') { %>
<footer class="mt-auto py-6 px-4 lg:px-gutter-desktop no-print">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3 text-on-surface-variant font-label-sm text-label-sm">
    <span class="flex items-center gap-2"><span class="material-symbols-outlined text-primary text-[18px]">verified</span>© <%= new Date().getFullYear() %> Doctory — متوافق مع قانون حماية البيانات الشخصية المصري 151/2020.</span>
    <nav class="flex items-center gap-4">
      <a class="hover:text-primary" href="/privacy">الخصوصية</a>
      <a class="hover:text-primary" href="/terms">الشروط</a>
      <a class="hover:text-primary" href="/contact-us">الدعم الفني</a>
    </nav>
  </div>
</footer>
<% } else { %>
<footer class="bg-navy text-white/80 mt-auto no-print">
  <div class="max-w-7xl mx-auto px-4 lg:px-8 py-12 grid grid-cols-2 md:grid-cols-4 gap-8">
    <div class="col-span-2 md:col-span-1 flex flex-col gap-3">
      <a href="/" class="flex items-center gap-2.5">
        <span class="w-10 h-10 rounded-xl bg-primary-container flex items-center justify-center"><span class="material-symbols-outlined icon-fill text-white">local_hospital</span></span>
        <span class="font-headline-sm text-headline-sm font-extrabold text-white">دكتوري</span>
      </a>
      <p class="font-body-md text-body-md text-white/60">احجز دكتورك، تابع دورك لحظة بلحظة، واستلم روشتتك رقمياً.</p>
    </div>
    <div class="flex flex-col gap-2">
      <p class="font-title-md text-title-md text-white mb-1">المنصة</p>
      <a class="hover:text-white" href="/doctors">ابحث عن طبيب</a>
      <a class="hover:text-white" href="/auth/register/doctor">انضم كطبيب</a>
      <a class="hover:text-white" href="/about-us">من نحن</a>
    </div>
    <div class="flex flex-col gap-2">
      <p class="font-title-md text-title-md text-white mb-1">المساعدة</p>
      <a class="hover:text-white" href="/faq">الأسئلة الشائعة</a>
      <a class="hover:text-white" href="/contact-us">اتصل بنا</a>
      <a class="hover:text-white" href="/refund">سياسة الاسترجاع</a>
    </div>
    <div class="flex flex-col gap-2">
      <p class="font-title-md text-title-md text-white mb-1">قانوني</p>
      <a class="hover:text-white" href="/terms">الشروط والأحكام</a>
      <a class="hover:text-white" href="/privacy">سياسة الخصوصية</a>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="max-w-7xl mx-auto px-4 lg:px-8 py-5 font-label-sm text-label-sm text-white/50">© <%= new Date().getFullYear() %> Doctory. جميع الحقوق محفوظة.</p>
  </div>
</footer>
<% } %>
