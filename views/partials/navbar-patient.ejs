<%#
  Patient top bar (search + notification bell + user chip).
  Locals: currentUser (from utils/checkLogin), pageTitle
%>
<%
  const _u = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : {};
  const _name = _u.name || 'مريض Doctory';
  const _initials = _name.replace(/^د\.\s*/, '').trim().split(/\s+/).slice(0, 2).map(function (w) { return w[0]; }).join('');
%>
<header class="fixed top-0 left-0 right-0 lg:right-72 z-30 h-16 bg-surface-container-lowest/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] px-4 lg:px-gutter-desktop flex items-center justify-between gap-3">
  <div class="flex items-center gap-3 flex-1 min-w-0">
    <button type="button" data-sidebar-toggle class="lg:hidden w-10 h-10 rounded-xl bg-surface-container-low hover:bg-surface-container-high flex items-center justify-center" aria-label="فتح القائمة">
      <span class="material-symbols-outlined">menu</span>
    </button>
    <form action="/doctors" method="get" class="relative w-full max-w-xs hidden sm:block" role="search">
      <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">search</span>
      <input name="q" type="search" placeholder="ابحث عن طبيب أو تخصص..."
        class="w-full pr-9 pl-4 py-2 bg-surface-container-low rounded-xl font-body-md text-body-md text-on-surface placeholder:text-on-surface-variant focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary/20 transition-all" />
    </form>
    <span class="sm:hidden font-title-md text-title-md text-on-surface truncate"><%= typeof pageTitle !== 'undefined' ? pageTitle : '' %></span>
  </div>
  <div class="flex items-center gap-2.5">
    <%- include('notification-bell', { href: '/patient/notifications' }) %>
    <div class="h-8 w-px bg-surface-variant mx-1 hidden sm:block"></div>
    <a href="/user/settings" class="flex items-center gap-3 p-1.5 pr-2 rounded-xl hover:bg-surface-container-low transition-colors">
      <span class="text-right hidden sm:flex flex-col leading-tight">
        <span class="font-label-md text-label-md font-bold text-on-surface"><%= _name %></span>
        <span class="font-label-sm text-label-sm text-secondary">حساب مريض</span>
      </span>
      <% if (_u.image_profile) { %>
        <img src="<%= _u.image_profile %>" alt="" class="w-9 h-9 rounded-full object-cover" />
      <% } else { %>
        <span class="w-9 h-9 rounded-full bg-primary-container text-on-primary flex items-center justify-center font-label-md text-label-md font-bold"><%= _initials %></span>
      <% } %>
    </a>
  </div>
</header>
