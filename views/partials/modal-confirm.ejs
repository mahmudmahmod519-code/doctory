<%# Confirm dialog driven by Doctory.confirm({ title, message, confirmText, danger, withReason }). %>
<div id="confirm-modal" class="hidden fixed inset-0 z-[80] items-center justify-center p-4 bg-navy/50 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
  <div data-confirm-panel class="w-full max-w-md bg-surface-container-lowest rounded-2xl shadow-modal p-6 flex flex-col gap-4">
    <div class="flex items-start gap-3">
      <span class="w-11 h-11 shrink-0 rounded-xl bg-[#FFFBEB] text-[#B45309] flex items-center justify-center"><span class="material-symbols-outlined">help</span></span>
      <div class="flex flex-col gap-1">
        <h2 id="confirm-title" data-confirm-title class="font-headline-sm text-headline-sm text-on-surface">تأكيد الإجراء</h2>
        <p data-confirm-message class="font-body-md text-body-md text-on-surface-variant"></p>
      </div>
    </div>
    <label data-confirm-reason-wrap class="hidden flex flex-col gap-1.5">
      <span class="font-label-md text-label-md text-on-surface">السبب (اختياري)</span>
      <textarea data-confirm-reason maxlength="500" rows="3" class="field" placeholder="اكتب السبب باختصار..."></textarea>
    </label>
    <div class="flex items-center justify-end gap-2 pt-1">
      <button type="button" data-confirm-cancel class="h-11 px-5 rounded-lg bg-surface-container-low hover:bg-surface-container-high text-on-surface font-label-md text-label-md">إلغاء</button>
      <button type="button" data-confirm-ok class="h-11 px-5 rounded-lg bg-primary-container text-on-primary font-label-md text-label-md font-bold hover:opacity-95 active:scale-[0.98] transition">تأكيد</button>
    </div>
  </div>
</div>
