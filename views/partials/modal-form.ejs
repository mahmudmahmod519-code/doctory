<%# Generic form dialog driven by Kit.dialog({ title, fields, submitText }) — see public/js/kit.js %>
<div id="kit-dialog" class="hidden fixed inset-0 z-[80] items-center justify-center p-4 bg-navy/50 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="kit-dialog-title">
  <form data-kit-panel class="w-full max-w-lg max-h-[90vh] overflow-y-auto bg-surface-container-lowest rounded-2xl shadow-modal p-6 flex flex-col gap-4" novalidate>
    <h2 id="kit-dialog-title" data-kit-title class="font-headline-sm text-headline-sm text-on-surface"></h2>
    <p data-kit-text class="hidden font-body-md text-body-md text-on-surface-variant"></p>
    <div data-kit-fields class="grid sm:grid-cols-2 gap-4"></div>
    <div class="flex items-center justify-end gap-2 pt-1">
      <button type="button" data-kit-cancel class="h-11 px-5 rounded-lg bg-surface-container-low hover:bg-surface-container-high font-label-md text-label-md">إلغاء</button>
      <button type="submit" data-kit-submit class="h-11 px-5 rounded-lg bg-primary-container text-on-primary font-label-md text-label-md font-bold">حفظ</button>
    </div>
  </form>
</div>
