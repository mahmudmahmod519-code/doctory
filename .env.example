# ==========================================
# 1. SERVER & GLOBAL CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=development
PUBLIC_FILE=public
BACKUP_DIR=backups
SSR=false

# ==========================================
# 2. SUPER ADMIN ACCOUNT
# ==========================================
ADMIN_MAIL=admin@doctory.com
ADMIN_PASS=Admin123456!
ADMIN_USER=SuperAdmin
ADMIN_PHONE=+201000000000

# ==========================================
# 3. CORS CONFIGURATION
# ==========================================
CORS_DOMAINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true
CORS_HTTP_ONLY=true
CORS_MAX_AGE=86400

# ==========================================
# 4. DATABASES CONFIGURATION
# ==========================================
# MongoDB - the only database in this project
# local:  mongodb://localhost:27017/clinic_db
# docker: mongodb://mongo:27017/clinic_db
MONGO_URI=mongodb://localhost:27017/clinic_db

# MongoDB - individual parts (used only if MONGO_URI is empty)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=
MONGO_PASS=
MONGO_DB_NAME=clinic_db

# Redis Cache Database
CACHE_URL=redis://localhost:6379
CACHE_DB_HOST=localhost
CACHE_DB_PORT=6379
CACHE_DB_USER=
CACHE_DB_PASS=
CACHE_DB_NAME=0
CACHE_SESSION_SECRET=super_redis_session_secret_key
CACHE_DB_RECOUNECTION=true

# ==========================================
# 5. UPLOAD & CLOUDINARY CONFIGURATION
# ==========================================
UPLOAD_DIR=public/uploads
UPLOAD_SIZE=5242880
UPLOAD_FILTER_MIMETYPE=image/jpeg,image/png,image/webp,application/pdf

# Cloudinary Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==========================================
# 6. AUTHENTICATION & SECURITY (JWT & BCRYPT)
# ==========================================
JWT_SECRET=super_jwt_access_secret_key_change_me
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_jwt_refresh_secret_key_change_me
JWT_REFRESH_EXPIRES_IN=7d
SALT_ROUNDS=12

# ==========================================
# 7. AI CONFIGURATION (OPENROUTER)
# ==========================================
BASEURL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
SITE_URL=http://localhost:3000
SITE_NAME=Doctory App
MODEL_NAME=anthropic/claude-3.5-sonnet
TEMPERATURE=0.7
MAX_TOKENS=1000

# ==========================================
# 8. RATE LIMITING & SECURITY
# ==========================================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# ==========================================
# 9. EMAIL / SMTP CONFIGURATION
# ==========================================
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM=no-reply@doctory.com

# ==========================================
# 10. LOGGING CONFIGURATION
# ==========================================
LOG_DIR=logs
LEVEL=info
